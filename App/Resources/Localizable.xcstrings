    "camera.no_frames.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera was opened but sent no picture within 10 seconds.\n\nFor an iPhone as Continuity Camera: keep it close to the Mac, signed in with the same Apple ID, with Wi-Fi and Bluetooth on and Continuity Camera enabled (Settings > General > AirPlay & Continuity). Lock the iPhone and mount it steadily, ideally in landscape. Then choose the camera again."
          }
        }
      }
    },
