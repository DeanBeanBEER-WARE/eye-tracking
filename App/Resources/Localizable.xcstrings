      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep looking at the dot while slowly turning and tilting your head a little."
          }
        }
      }
    },
    "calibration.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibration: look at each dot until it disappears and keep your head still.\nPress Esc to cancel."
