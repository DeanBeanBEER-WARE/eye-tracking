    "calibration.outdated.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The eye measurement has changed, so the saved calibration no longer fits. Gaze control stays off until you calibrate again.\n\nCalibration takes about 90 seconds. Keep your head as still as possible at the grid dots and look straight at each dot."
          }
        }
      }
    },
