    "pointer.permissions.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eye Tracking needs the Accessibility permission (System Settings > Privacy & Security) to move the pointer and to pass on clicks, scrolling and dragging of the external mouse. The trackpad always stays free.\n\nIf macOS also asks for Input Monitoring, please allow it as well. Gaze control starts automatically once the permission is granted."
          }
        }
      }
    },
